{
  "name": "inkwell",
  "private": true,
  "version": "1.0.0",
  "description": "Inkwell — a full-featured, offline-first notes app for Android. Vue 3 + Vite 8 + Capacitor 8 + RxDB + PrimeVue.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:db": "node test/node-db-test.mjs",
    "cap:sync": "cap sync android",
    "assets": "capacitor-assets generate --android",
    "android:open": "cap open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "test:web": "vite build && node test/web-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@primeuix/themes": "^2.0.3",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "primeicons": "^8.0.2",
    "primevue": "4.5.5",
    "quill": "^2.0.3",
    "rxdb": "^17.6.0",
    "rxjs": "^7.8.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "puppeteer": "^25.14.0",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
